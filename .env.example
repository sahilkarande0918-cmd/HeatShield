# ---------------------------------------------------------------------------
# HeatShield environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Neon serverless Postgres connection string.
# Get it from: https://console.neon.tech -> your project -> Connection Details
# Use the "pooled" connection string. Required from Phase 2 onward.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API key, used for the AI-generated ward advisories (Phase 6).
# Get it from: https://aistudio.google.com/apikey  (free tier, no card needed)
# If absent, the app falls back to deterministic templated advisories.
GEMINI_API_KEY=""

# Which city the app boots into. Must match a city key in lib/cities.ts.
NEXT_PUBLIC_DEFAULT_CITY="pune"

# ---------------------------------------------------------------------------
# No key needed for these — documented here so you know what the app talks to:
#   Open-Meteo   https://api.open-meteo.com   live temperature/humidity forecast
#   OpenFreeMap  https://tiles.openfreemap.org  basemap vector tiles (MapLibre)
#   Overpass     https://overpass-api.de      OSM buildings + hospitals (seed only)
# ---------------------------------------------------------------------------
